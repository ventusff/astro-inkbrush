{
  "name": "astro-inkbrush",
  "version": "0.2.1",
  "private": true,
  "description": "A tiny git-backed CMS for Astro: in-place block editing, revision history, comments, AI assist and an Obsidian inbox — as one dev-mode integration with zero footprint in production builds.",
  "type": "module",
  "author": "Jianfei Guo",
  "license": "MIT",
  "homepage": "https://ventusff.github.io/astro-inkbrush/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventusff/astro-inkbrush.git"
  },
  "bugs": {
    "url": "https://github.com/ventusff/astro-inkbrush/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "git-based-cms",
    "markdown",
    "mdx",
    "wiki",
    "digital-garden",
    "obsidian",
    "self-hosted",
    "withastro",
    "content-editor",
    "revision-history",
    "ai-assistant",
    "claude",
    "astro-cms"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./config": "./src/wiki/config.ts",
    "./session": "./src/wiki/server/session.ts",
    "./wikilinks": "./src/lib/wikilinks.ts",
    "./wikilinks/core": "./src/lib/wikilink-core.ts",
    "./wiki-blocks": "./src/lib/rehype-wiki-blocks.ts",
    "./markdown": "./src/lib/markdown.ts",
    "./render-pipeline": "./src/lib/render-pipeline.ts",
    "./playground": "./src/wiki/playground/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "deploy",
    "inkbrush.config.example.ts",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@mdx-js/mdx": "^3.1.1",
    "@node-saml/node-saml": "^5.1.0",
    "chokidar": "^5.0.0",
    "jose": "^6.2.3",
    "katex": "^0.17.0",
    "micromark-extension-cjk-friendly-util": "^3.0.1",
    "parse5": "^7.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tar": "^7.4.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  }
}
