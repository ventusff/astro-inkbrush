---
/**
 * Site shell. Everything visual here belongs to the demo — astro-inkbrush
 * ships no page layout and styles only its own chrome (wiki.css, injected
 * in WIKI mode only). The one engine touchpoint in this file is an optional
 * DOM slot:
 *   [data-inkbrush-slot="account"]  → the sign-in chip mounts in the header
 * (the comments slot lives on note pages; see pages/notes/[...id].astro)
 */
import '../styles/site.css';

interface Props {
  title: string;
  description?: string | undefined;
  /** page language — the CMS client picks its UI language from <html lang> */
  lang?: string;
}
const { title, description, lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Field Notes</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>Field Notes</a>
      <span class="brand-sub">an <a href="https://github.com/ventusff/astro-inkbrush">astro-inkbrush</a> demo</span>
      <span class="spacer"></span>
      <span data-inkbrush-slot="account"></span>
    </header>
    <slot />
    <footer class="site-footer">
      <p>
        Built with <a href="https://astro.build">Astro</a> and
        <a href="https://github.com/ventusff/astro-inkbrush">astro-inkbrush</a> —
        clone the repo and run <code>npm run wiki</code> in <code>demo/</code> to edit this site in place.
      </p>
    </footer>
  </body>
</html>
