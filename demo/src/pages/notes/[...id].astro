---
/**
 * Note page. The engine touchpoints, in order:
 *   <meta name="inkbrush-note">      which note this page is (the client
 *                                    never parses URLs — routing belongs
 *                                    to the site)
 *   <meta name="inkbrush-note-url">  URL template for locale jumps
 *   .note-main                       the reading column
 *   [data-inkbrush-slot="comments"]  where the comment section mounts
 * Everything else is plain Astro.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isZh = note.id.startsWith('zh/');
const mirrorId = isZh ? note.id.slice(3) : `zh/${note.id}`;
const mirror = (await getCollection('notes')).find((n) => n.id === mirrorId);
---

<Base title={note.data.title} description={note.data.description} lang={isZh ? 'zh-CN' : 'en'}>
  <Fragment slot="head">
    <meta name="inkbrush-note" content={note.id} />
    <meta name="inkbrush-note-url" content={`${base}/notes/{id}/`} />
  </Fragment>
  <main class="note-main">
    <nav class="crumbs">
      <a href={`${base}/`}>{isZh ? '所有笔记' : 'All notes'}</a>
      {mirror && (
        <a class="mirror" href={`${base}/notes/${mirrorId}/`}>
          {isZh ? 'English version' : '中文版'}
        </a>
      )}
    </nav>
    <article>
      <h1>{note.data.title}</h1>
      <Content />
    </article>
    <div data-inkbrush-slot="comments"></div>
  </main>
</Base>
