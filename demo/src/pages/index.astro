---
/** Note index: unprefixed (English) notes, with a hint when a note also has
 *  a zh/ mirror. Ordering is editorial — the welcome note leads. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('notes');
const ORDER = ['welcome', 'editing', 'revisions', 'ai-assist', 'wikilinks', 'garden-craft', 'inbox'];
const primary = all
  .filter((n) => !n.id.startsWith('zh/'))
  .sort((a, b) => {
    const ai = ORDER.indexOf(a.id);
    const bi = ORDER.indexOf(b.id);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi) || a.id.localeCompare(b.id);
  });
const hasZh = new Set(all.filter((n) => n.id.startsWith('zh/')).map((n) => n.id.slice(3)));
---

<Base title="All notes" description="A multi-note demo site for astro-inkbrush — a tiny git-backed CMS for Astro.">
  <main class="note-index">
    <h1>Field Notes</h1>
    <p class="lede">
      A small garden of notes about the tool that edits them. Read on, or clone the
      repo and run <code>npm run wiki</code> to open this very site in editing mode.
    </p>
    <ul class="note-list">
      {primary.map((n) => (
        <li>
          <a href={`${base}/notes/${n.id}/`}>{n.data.title}</a>
          {hasZh.has(n.id) && <a class="mirror" href={`${base}/notes/zh/${n.id}/`} title="中文版">中文</a>}
          {n.data.description && <p>{n.data.description}</p>}
        </li>
      ))}
    </ul>
  </main>
</Base>
