{
  "name": "astro-inkbrush-demo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-note demo site for astro-inkbrush — run `npm run wiki` to edit it in place",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node ../scripts/check-dist.mjs dist --base ${DEMO_BASE:-/}",
    "preview": "astro preview",
    "wiki": "WIKI=1 astro dev",
    "check": "node ../scripts/check-content.mjs src/content/notes"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "astro-inkbrush": "file:.."
  }
}
