{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "astro/client"
    ]
  }
}
